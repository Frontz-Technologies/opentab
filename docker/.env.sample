# =============================================================================
# Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# For development, use .env.dev.sample instead.
#
# Usage:
#   cp .env.sample .env
#   # Edit .env with production values
#   docker compose -f docker-compose.yml up --build -d
#   (or from project root: make prod)

# Database (PostgreSQL 16)
POSTGRES_DB=opentab
POSTGRES_USER=opentab
POSTGRES_PASSWORD=                              # REQUIRED — use a strong password
DATABASE_URL=postgresql://opentab:YOUR_PASSWORD@postgres:5432/opentab

# Auth (Better Auth)
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=                             # REQUIRED — random 64+ char string

# Credential encryption key for country-integration credentials (AES-256-GCM, 32 bytes hex).
# Generate with: openssl rand -hex 32
# MUST be stored separately from pg_dump backups — a compromised backup plus key
# is equivalent to plaintext.
ENCRYPTION_KEY=                                 # REQUIRED — 64 hex chars

# Email — Option A: Resend (cloud)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Email — Option B: SMTP (self-hosted)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
EMAIL_FROM=noreply@example.com

# Redis (job queue + report cache)
REDIS_URL=redis://redis:6379

# Async job queue admin dashboard (#85). When true AND the requesting
# session has owner|admin role, /admin/queues exposes Bull Board.
# Default off in prod — flip on for incident response then flip back.
ENABLE_QUEUE_DASHBOARD=false

# AI Configuration
# Required for storing OpenRouter API keys encrypted in the database.
# Generate with: openssl rand -hex 32
AI_ENCRYPTION_KEY=                              # REQUIRED for AI features
# Optional deployment-level overrides. When set, they win over the
# per-org values stored from /settings/integrations/ai. Leave the model
# vars unset to let each org pick one in the UI; leave both env + DB
# empty and the feature stays off (no default model is assumed).
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# AI_MODEL_CHAT=openai/gpt-4o-mini
# AI_MODEL_EXTRACTION=openai/gpt-4o
# FEATURE_AI_EXTRACTION=on
# NEXT_PUBLIC_FEATURE_AI_CHAT=off

# File Storage — local disk by default (uses Docker volume).
# For S3-compatible storage (Hetzner Object Storage, Scaleway, AWS, MinIO),
# uncomment and configure these:
# S3_ENDPOINT=                                  # e.g. https://fsn1.your-objectstorage.com
# S3_PUBLIC_ENDPOINT=                           # Optional — public URL if different from S3_ENDPOINT
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=opentab-uploads
# S3_REGION=eu-west-1
# S3_FORCE_PATH_STYLE=false                     # true for MinIO, false for AWS/Scaleway/Hetzner

# PDF Generation
GOTENBERG_URL=http://gotenberg:3000             # Default works with Docker Compose

# Webhooks (optional)
# EXPENSE_EMAIL_WEBHOOK_SECRET=                 # Secret for expense email ingestion webhook

# App
NEXT_PUBLIC_APP_URL=https://app.example.com
NODE_ENV=production

# Domain for Caddy automatic HTTPS
DOMAIN=app.example.com

# Sample-data / demo workspace (optional).
# When set to "true", a "Try the demo" card appears on the login page
# and one click signs the visitor into a pre-populated fictional
# business. Designed for staging/demo deployments where you want
# frictionless exploration. Both variables must match.
# LEAVE UNSET for any real-customer production — the demo account uses
# a hardcoded published password and is not meant to run in prod.
# DEMO_SAMPLE_DATA_ENABLED=true
# NEXT_PUBLIC_DEMO_SAMPLE_DATA_ENABLED=true
