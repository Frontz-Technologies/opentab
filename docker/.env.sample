# =============================================================================
# Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# For development, use .env.dev.sample instead.
#
# Usage:
#   cp .env.sample .env
#   # Edit .env with production values
#   docker compose -f docker-compose.yml up --build -d
#   (or from project root: make prod)

# Database (PostgreSQL 16)
POSTGRES_DB=opentab
POSTGRES_USER=opentab
POSTGRES_PASSWORD=                              # REQUIRED — use a strong password
DATABASE_URL=postgresql://opentab:YOUR_PASSWORD@postgres:5432/opentab

# Auth (Better Auth)
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=                             # REQUIRED — random 64+ char string

# Email — Option A: Resend (cloud)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Email — Option B: SMTP (self-hosted)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
EMAIL_FROM=noreply@example.com

# Redis
REDIS_URL=redis://redis:6379

# AI Configuration
# Required for storing OpenRouter API keys encrypted in the database.
# Generate with: openssl rand -hex 32
AI_ENCRYPTION_KEY=                              # REQUIRED for AI features
# Optional fallback for invoice email AI generation (bypasses DB-stored key)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# File Storage (S3-compatible — Hetzner Object Storage, Scaleway, AWS, MinIO)
S3_ENDPOINT=                                    # REQUIRED — e.g. https://fsn1.your-objectstorage.com
S3_PUBLIC_ENDPOINT=                             # Optional — public URL if different from S3_ENDPOINT
S3_ACCESS_KEY_ID=                               # REQUIRED
S3_SECRET_ACCESS_KEY=                           # REQUIRED
S3_BUCKET=opentab-uploads                       # REQUIRED
S3_REGION=eu-west-1
S3_FORCE_PATH_STYLE=false                       # true for MinIO, false for AWS/Scaleway/Hetzner

# PDF Generation
GOTENBERG_URL=http://gotenberg:3000             # Default works with Docker Compose

# Webhooks (optional)
# EXPENSE_EMAIL_WEBHOOK_SECRET=                 # Secret for expense email ingestion webhook

# App
NEXT_PUBLIC_APP_URL=https://app.example.com
NODE_ENV=production

# Domain for Caddy automatic HTTPS
DOMAIN=app.example.com
