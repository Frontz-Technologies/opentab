# =============================================================================
# Development Environment Variables
# =============================================================================
# Copy this file to .env and you're ready to go — defaults work out of the box.
#
# Usage:
#   cp .env.dev.sample .env
#   docker compose -f docker-compose.dev.yml up --build
#   (or from project root: make dev)

# Database (PostgreSQL 16)
POSTGRES_DB=opentab_dev
POSTGRES_USER=opentab
POSTGRES_PASSWORD=opentab_dev
DATABASE_URL=postgresql://opentab:opentab_dev@postgres:5432/opentab_dev

# Auth (Better Auth)
BETTER_AUTH_SECRET=dev-secret-change-me-in-production

# Redis
REDIS_URL=redis://redis:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# AI Configuration (optional — uncomment to test AI features locally)
# Generate encryption key with: openssl rand -hex 32
# AI_ENCRYPTION_KEY=
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Email (optional — uncomment to test email locally)
# EMAIL_FROM=noreply@localhost
# RESEND_API_KEY=re_xxxxxxxxxxxx
