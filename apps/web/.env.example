# Set to "off" to disable /register; rely on manual provisioning only.
PUBLIC_REGISTRATION=on

# /legal renders links to whichever URLs are configured. If all unset,
# /legal returns 404 (the OSS app bundles no legal text).
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=
LEGAL_COOKIES_URL=
LEGAL_DPA_URL=

# Transactional email — any SMTP relay works.
EMAIL_DRIVER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=OpenTab

# Object storage — any S3-compatible provider.
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Symmetric secrets for credential + AI-key encryption (32-byte hex).
# Generate with: openssl rand -hex 32
# REQUIRED: app crashes at boot if either is missing.
ENCRYPTION_KEY=
AI_ENCRYPTION_KEY=

# AI features (extraction needs vision-capable model).
OPENROUTER_API_KEY=
FEATURE_AI_EXTRACTION=on
AI_MODEL_EXTRACTION=openai/gpt-4o
# Single env: NEXT_PUBLIC_* is available on both client and server,
# so the FAB and the API route stay in sync from one source.
NEXT_PUBLIC_FEATURE_AI_CHAT=off

# Error monitoring — Sentry-protocol DSN (Sentry, GlitchTip, etc.).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Nightly age-encrypted pg_dump → off-region S3.
# Leave BACKUP_AGE_PUBLIC_KEY unset to disable the cron entirely.
# Private key MUST live offline — losing it = unrecoverable backups.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_AGE_PUBLIC_KEY=

# GlitchTip self-host (only if running glitchtip via docker-compose).
GLITCHTIP_SECRET_KEY=
GLITCHTIP_URL=

POSTGRES_USER=opentab
POSTGRES_PASSWORD=
POSTGRES_DB=opentab
BETTER_AUTH_SECRET=
APP_URL=
